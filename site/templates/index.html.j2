<!doctype html>
<html lang="{{ meta.html_lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="{{ t.meta.description }}">
<title>{{ t.meta.title }}</title>
<link rel="icon" href="{{ root }}assets/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="{{ root }}assets/site.css">
{% if links.website_url %}<link rel="canonical" href="{{ links.website_url }}{{ meta.dir }}">
{% for l, m in langs.items() %}<link rel="alternate" hreflang="{{ m.html_lang }}" href="{{ links.website_url }}{{ m.dir }}">
{% endfor %}{% endif %}
</head>
<body>
<a class="skip-link" href="#main">{{ t.nav.skip }}</a>
<header class="site-header">
  <a class="brand" href="{{ root }}index.html" aria-label="IVAD home"><span class="brand-mark" aria-hidden="true">I<span>V</span></span> IVAD <span class="brand-owner">/ Leon Lai</span></a>
  <nav aria-label="{{ 'Main navigation' if lang == 'en' else '主要導覽' }}">
    <a href="#explorations">{{ t.nav.explorations }}</a><a href="#findings">{{ t.nav.findings }}</a><a href="#lessons">{{ t.nav.lessons }}</a><a href="#code">{{ t.nav.code }}</a>
  </nav>
  <div class="language-switch" role="group" aria-label="{{ t.nav.language }}">
  {% for l,m in langs.items() %}<a href="{{ alt[l] }}index.html" lang="{{ m.html_lang }}" hreflang="{{ m.html_lang }}"{% if l == lang %} aria-current="page"{% endif %}>{{ m.label }}</a>{% endfor %}
  </div>
</header>
<main id="main">
  <section class="hero" id="summary" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">{{ t.hero.eyebrow }}</p>
      <h1 id="hero-title">{{ t.hero.title }}</h1>
      <p class="subtitle">{{ t.hero.subtitle }}</p>
      <p class="hero-intro">{{ t.hero.intro }}</p>
      <p class="byline">{{ t.hero.owner }} <span aria-hidden="true">/</span> Computer Vision</p>
      {% if links.website_url %}<p class="print-only"><a href="{{ links.website_url }}{{ meta.dir }}">{{ links.website_url }}{{ meta.dir }}</a></p>{% endif %}
      <div class="actions"><a class="button primary" href="#explorations">{{ t.hero.primary }} <span aria-hidden="true">↓</span></a><a class="button secondary" href="{{ root }}{{ 'project-notes.zh-TW.pdf' if lang == 'zh-TW' else 'executive-summary-one-page.pdf' }}">{{ t.hero.pdf }} <span aria-hidden="true">↗</span></a></div>
      <p class="download-note">{{ t.hero.pdf_note }}</p>
    </div>
    <figure class="hero-figure">
      <div class="figure-heading"><span class="signal" aria-hidden="true"></span>{{ t.hero.image_label }}<span class="figure-chip">CNN / PCB2</span></div>
      <img src="{{ root }}assets/img/workflow_caught.jpg" width="960" height="640" alt="{{ t.hero.image_alt }}">
      <figcaption>{{ t.hero.image_caption }}</figcaption>
    </figure>
  </section>
  <section class="section explorations" id="explorations" aria-labelledby="explorations-title">
    <div class="section-heading"><p class="eyebrow">{{ t.explorations.eyebrow }}</p><h2 id="explorations-title">{{ t.explorations.title }}</h2><p>{{ t.explorations.intro }}</p></div>
    <div class="workflow-grid">
    {% for r in t.rounds %}
      <article class="workflow round-{{ r.key }}" aria-labelledby="round-{{ r.key }}">
        <div class="round-heading"><span class="round-letter">{{ r.letter }}</span><span class="dataset">{{ r.dataset }}</span></div>
        <h3 id="round-{{ r.key }}">{{ r.title }}</h3>
        <p class="round-question">{{ r.question }}</p>
        <p class="training-tag">{{ [t.explorations.normal,t.explorations.robustness,t.explorations.supervised][loop.index0] }}</p>
        <ol class="steps">{% for step in r.steps %}<li><span class="step-dot" aria-hidden="true"></span><span>{{ step }}</span></li>{% endfor %}</ol>
        <p class="challenge">{{ r.challenge }}</p>
        <p class="round-learning">{{ r.learning }}</p>
      </article>
    {% endfor %}
    </div>
  </section>
  <section class="section findings" id="findings" aria-labelledby="findings-title">
    <div class="section-heading"><p class="eyebrow">{{ t.findings.eyebrow }}</p><h2 id="findings-title">{{ t.findings.title }}</h2><p>{{ t.findings.intro }}</p></div>
    <div class="finding-grid">
    {% for item in t.findings['items'] %}
      <article class="finding round-{{ ['a','b','c'][loop.index0] }}">
        <div class="finding-heading"><span class="round-letter">{{ item.letter }}</span><h3>{{ item.title }}</h3></div>
        <figure><img src="{{ root }}assets/img/{{ item.image }}" width="{{ item.w }}" height="{{ item.h }}" alt="{{ item.alt }}"><figcaption>{{ item.caption }}</figcaption></figure>
        <dl>
          <dt>{{ t.findings.question_label }}</dt><dd>{{ item.question }}</dd>
          <dt>{{ t.findings.technique_label }}</dt><dd>{{ item.technique }}</dd>
          <dt>{{ t.findings.result_label }}</dt><dd class="result">{{ item.result }}</dd>
          <dt>{{ t.findings.lesson_label }}</dt><dd>{{ item.lesson }}</dd>
        </dl>
      </article>
    {% endfor %}
    </div>
    <p class="comparison-note">{{ t.findings.caveat }}</p>
  </section>
  <section class="section lessons" id="lessons" aria-labelledby="lessons-title">
    <div class="section-heading"><p class="eyebrow">{{ t.lessons.eyebrow }}</p><h2 id="lessons-title">{{ t.lessons.title }}</h2></div>
    <div class="lesson-grid">{% for item in t.lessons['items'] %}<article><span class="lesson-number" aria-hidden="true">{{ '%02d'|format(loop.index) }}</span><h3>{{ item.title }}</h3><p>{{ item.text }}</p></article>{% endfor %}</div>
  </section>
  <section class="section code-section" id="code" aria-labelledby="code-title">
    <div><p class="eyebrow">{{ t.code.eyebrow }}</p><h2 id="code-title">{{ t.code.title }}</h2><p>{{ t.code.text }}</p>{% if links.source_mode == 'private-repository' %}<p class="source-status">{{ t.code.private_note }}</p>{% endif %}</div>
    <div class="code-actions">{% if links.technical_repository_url %}<a class="button primary" href="{{ links.technical_repository_url }}">{{ t.code.private_label if links.source_mode == 'private-repository' else t.code.public_label }} <span aria-hidden="true">↗</span></a>{% endif %}{% if links.technical_evidence_url %}<a class="button secondary" href="{{ links.technical_evidence_url }}">{{ t.code.evidence_label }} <span aria-hidden="true">↗</span></a>{% endif %}<a class="button secondary" href="{{ root }}{{ 'project-notes.zh-TW.pdf' if lang == 'zh-TW' else 'executive-summary-one-page.pdf' }}">{{ t.code.pdf_label }} <span aria-hidden="true">↗</span></a></div>
  </section>
</main>
<footer class="site-footer">
  <div><a class="footer-brand" href="{{ root }}index.html">IVAD / Yu-Chen (Leon) Lai</a><p>{{ t.footer.disclosure }}</p><p>{{ t.footer.attribution }}</p></div>
  <div class="footer-links"><a href="https://github.com/amazon-science/spot-diff">{{ t.footer.dataset }}</a><a href="https://creativecommons.org/licenses/by/4.0/">{{ t.footer.license }}</a><a href="{{ root }}NOTICE.md">{{ t.footer.notice }}</a></div>
</footer>
</body>
</html>
