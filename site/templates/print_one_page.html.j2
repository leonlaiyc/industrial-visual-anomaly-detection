<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>{{ p.title }} - One-page project sheet</title>
<link rel="icon" href="../../assets/favicon.svg" type="image/svg+xml">
<style>
@page{size:A4;margin:11mm 12mm 10mm}*{box-sizing:border-box}html{-webkit-print-color-adjust:exact;print-color-adjust:exact}
body{margin:0;font:9pt/1.4 "Segoe UI",Arial,sans-serif;color:#152c36;background:white}.page{max-width:184mm;margin:auto}h1,h2,h3,p,figure{margin:0}a{color:#11666a;text-decoration:none}
.kicker{font-size:8pt;color:#11666a;letter-spacing:.08em;font-weight:700;margin-bottom:5pt}h1{font-size:19pt;letter-spacing:-.025em;line-height:1.12;max-width:170mm} .subtitle{font-size:11pt;margin:6pt 0;color:#3d5960}.owner{font-size:8pt;color:#4d626b;margin-bottom:7pt}.motivation{font-size:8.5pt;line-height:1.4;max-width:180mm}h2{font-size:11pt;margin:11pt 0 6pt} .workflows{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9pt}
.round{border: .7pt solid #d8e1df;border-top:2.5pt solid var(--accent);border-radius:5pt;padding:9pt 9pt 8pt;background:#fcfdfb;display:flex;flex-direction:column}
.a{--accent:#11666a}.b{--accent:#98512c}.c{--accent:#414c9a}.round-head{display:flex;align-items:center;gap:7pt;margin-bottom:4pt}.letter{display:flex;align-items:center;justify-content:center;background:var(--accent);color:white;font-size:10pt;font-weight:700;width:21pt;height:21pt;border-radius:4pt;flex-shrink:0}
h3{font-size:10pt;line-height:1.25}.dataset{font-size:7pt;line-height:1.35;color:#4d626b;min-height:18pt}.steps{list-style:none;margin:8pt 0 7pt;padding:0;border-bottom:.7pt solid #d8e1df}.steps li{font-size:8pt;line-height:1.3;min-height:23pt;padding:0 0 8pt 10pt;position:relative}.steps li:before{content:"";position:absolute;left:0;top:3pt;width:4pt;height:4pt;border-radius:50%;background:var(--accent)}.steps li:not(:last-child):after{content:"";position:absolute;left:1.7pt;top:9pt;bottom:2pt;border-left:.5pt solid #bccdc8}
.finding{font-size:8pt;line-height:1.4;flex:1}.learned{font-size:8pt;line-height:1.4;color:var(--accent);margin-top:7pt}.label{font-size:6.8pt;font-weight:750;letter-spacing:.07em;color:var(--accent);display:block;margin-bottom:3pt}.visuals{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9pt;margin-top:10pt}.visuals img{width:100%;height:48pt;object-fit:contain;background:#edf1ed;border:.6pt solid #d8e1df;border-radius:3pt}.visuals figcaption{font-size:6.7pt;color:#4d626b;margin-top:4pt}.limits{font-size:7.5pt;color:#4d626b;background:#f0f4f0;padding:6pt 8pt;margin-top:7pt;border-left:2pt solid #11666a}
.lessons{display:grid;grid-template-columns:1fr 1fr;gap:5pt 12pt;padding:0;list-style:none}.lessons li{font-size:8.5pt;line-height:1.35;padding-left:10pt;position:relative}.lessons li:before{content:"";width:4pt;height:4pt;border-radius:50%;background:#11666a;position:absolute;left:0;top:4pt}
.project{border-top:.7pt solid #d8e1df;margin-top:10pt;padding-top:9pt}.project h2{margin:0 0 5pt}.url{font-size:8pt;overflow-wrap:anywhere;margin-bottom:4pt}.pending{font-size:8pt;color:#4d626b;margin-bottom:4pt}.evidence{font-size:7.1pt;line-height:1.4;color:#4d626b;margin-top:5pt}.foot{margin-top:8pt;padding-top:7pt;border-top:.7pt solid #d8e1df;font-size:6.9pt;line-height:1.4;color:#4d626b}
</style></head>
<body><main class="page">
<p class="kicker">IVAD / PROJECT SHARING SHEET</p><h1>{{ p.title }}</h1><p class="subtitle">{{ p.subtitle }}</p><p class="owner">Yu-Chen (Leon) Lai</p><p class="motivation">{{ p.motivation }}</p>
<h2>{{ p.workflows_h }}</h2><div class="workflows">{% for r in p.rounds %}<section class="round {{ ['a','b','c'][loop.index0] }}"><div class="round-head"><span class="letter">{{ r.letter }}</span><h3>{{ r.title }}</h3></div><p class="dataset">{{ r.dataset }}</p><ol class="steps">{% for s in r.steps %}<li>{{ s }}</li>{% endfor %}</ol><div class="finding"><span class="label">OBSERVED</span><p>{{ r.finding }}</p></div><p class="learned"><span class="label">LEARNED</span>{{ r.learned }}</p></section>{% endfor %}</div>
<div class="visuals">{% for v in p.visuals %}<figure><img src="../../assets/img/{{ v.image }}" alt="{{ v.caption }}" width="960" height="640"><figcaption>{{ v.caption }}</figcaption></figure>{% endfor %}</div>
<p class="limits">{{ p.limits }}</p><h2>{{ p.lessons_h }}</h2><ul class="lessons">{% for l in p.lessons %}<li>{{ l }}</li>{% endfor %}</ul>
<div class="project"><h2>{{ p.project_h }}</h2>{% if links.website_url %}<p class="url"><a href="{{ links.website_url }}">{{ links.website_url }}</a></p>{% else %}<p class="pending">{{ p.pending }}</p>{% endif %}{% if links.technical_repository_url %}<p class="url">{{ p.source_private if links.source_mode == 'private-repository' else p.source_public }}: <a href="{{ links.technical_repository_url }}">github.com/leonlaiyc/industrial-visual-anomaly-detection</a></p>{% endif %}<p class="evidence">{{ p.evidence }}</p></div>
<p class="foot">{{ p.disclaimer }} <a href="https://github.com/amazon-science/spot-diff">Dataset source</a> 繚 <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a></p>
</main></body></html>
